# Example .env file for backend
GEMINI_API_KEY=your_gemini_api_key_here

# For Production Security, generate a secure random string for JWT:
# You can generate one using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_very_secret_random_string_here

# Groq API Key for the LLM (Replaces Ollama in Production)
GROQ_API_KEY=your_groq_api_key_here

# For local PostgreSQL testing:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/kubera_ai

# Note: On Render, the DATABASE_URL environment variable is usually automatically
# provided if you attach a Render PostgreSQL database to your Web Service.
